{
  "name": "@ball6847/serve-md",
  "version": "1.0.6",
  "license": "MIT",
  "tasks": {
    "fmt": "deno fmt src/",
    "lint": "deno lint src/",
    "test": "deno test -A src/",
    "check": "deno fmt --check src/ && deno lint src/ && deno test -A src/",
    "serve": "deno run --allow-read --allow-net --allow-env --allow-run src/cli/main.ts serve",
    "install:local": "deno install --global --compile --allow-read --allow-net --allow-env --allow-run -n serve-md-local --config deno.json --force ./src/cli/main.ts",
    "install:jsr": "deno install --global --allow-read --allow-net --allow-env --allow-run -n serve-md --force jsr:@ball6847/serve-md",
    "release:check": "npx jsr publish --dry-run --allow-dirty"
  },
  "imports": {
    "await-to-js": "npm:await-to-js@^3",
    "zod": "npm:zod@^3",
    "hono": "npm:hono@^4",
    "marked": "npm:marked@^14",
    "highlight.js": "npm:highlight.js@^11",
    "cliffy": "jsr:@cliffy/command@^1",
    "dotenv": "jsr:@std/dotenv@^0.225.7",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/path": "jsr:@std/path@^1"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "exactOptionalPropertyTypes": true
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true,
    "include": [
      "src/"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    },
    "include": [
      "src/"
    ]
  },
  "exports": {
    ".": "./src/cli/main.ts"
  },
  "compile": {
    "include": [
      "./src/ui/"
    ]
  }
}
